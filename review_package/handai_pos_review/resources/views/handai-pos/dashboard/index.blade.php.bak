@section('page-script')
<script>
    function cartForm(variants) {
        return {
            variants: variants,
            selectedVariantId: variants.length > 0 ? variants[0].id : '',
            get selectedVariant() {
                return this.variants.find(v => v.id == this.selectedVariantId) || {};
            }
        };
    }
</script>
@endsection