        @php
            $fgSortUrl = function($field) {
                $current = request('sort', 'name');
                $dir = ($current === $field && request('dir', 'asc') === 'asc') ? 'desc' : 'asc';
                return request()->fullUrlWithQuery(['sort' => $field, 'dir' => $dir, 'tab' => 'produk']);
            };
            $fgSortIcon = function($field) {
                $current = request('sort', 'name');
                $dir = request('dir', 'asc');
                if ($current !== $field) return '';
                return $dir === 'asc' ? '↑' : '↓';
            };
        @endphp

