        @php
            $currentSort = request('sort', 'name');
            $currentDir  = request('dir', 'asc');
            $sortUrl = function($field) use ($tab) {
                $current = request('sort', 'name');
                $dir = ($current === $field && request('dir', 'asc') === 'asc') ? 'desc' : 'asc';
                return request()->fullUrlWithQuery(['sort' => $field, 'dir' => $dir, 'tab' => $tab]);
            };
            $sortIcon = function($field) {
                $current = request('sort', 'name');
                $dir = request('dir', 'asc');
                if ($current !== $field) return '';
                return $dir === 'asc' ? '↑' : '↓';
            };
        @endphp

        {{-- Desktop table --}}
        <div class="hidden md:block overflow-x-auto">
